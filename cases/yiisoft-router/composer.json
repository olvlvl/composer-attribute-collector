{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "composer-attribute-collector"
        }
    ],
    "require": {
        "php": ">=8.2",
        "olvlvl/composer-attribute-collector": "*",
        "yiisoft/router": "dev-add-attributes as 4",
        "yiisoft/router-composer-attribute-collector": "dev-master",
        "yiisoft/router-fastroute": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "olvlvl/composer-attribute-collector": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "vendor/attributes.php"
        ]
    }
}
